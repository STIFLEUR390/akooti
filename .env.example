# Copiez ce fichier vers `.env.local` (ignoré par git).
# Ne committez jamais de secret réel : ce fichier ne contient que des valeurs
# publiques ou de développement.

# Verbosité des logs du binaire (error | warn | info | debug | trace)
AKOOTI_LOG=info

# Projet Supabase personnel (BYO). Ces variables ne sont PAS lues par
# l'application : la synchronisation se configure dans « Sync & sauvegardes »
# (URL + clé anon publiques), et la clé `service_role`/`sb_secret_…` ne doit
# jamais entrer dans Akooti. Elles ne servent qu'à des scripts locaux.
AKOOTI_SUPABASE_URL=
AKOOTI_SUPABASE_ANON_KEY=

# Frontend desktop
VITE_AKOOTI_ENV=development
