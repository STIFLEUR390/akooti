{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Akooti",
  "version": "0.1.0",
  "identifier": "com.akooti.desktop",
  "build": {
    "beforeDevCommand": "bun run --filter @akooti/desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run --filter @akooti/desktop build",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Akooti",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
