# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# Bun / frontend
node_modules/
.bun/
bun-debug.log*
*.tsbuildinfo
dist/
build/
coverage/

# Vite / WXT
.vite/
.output/
.wxt/
.stats.html

# CodeGraph index (local code intelligence cache)
.codegraph/

# Tauri
src-tauri/gen/
src-tauri/target/
apps/desktop/src-tauri/gen/

# Akooti runtime artifacts (vaults, backups, exports)
*.akooti
*.bcup
*.kdbx
*.1pux
*.sqlcipher
*.db-journal
*.db-wal
*.db-shm
backups/
exports/

# Secrets & local config
.env
.env.*
!.env.example
*.pem
*.p12
*.key

# Local test vault + MCP wiring (real test secrets, never committed):
# TEST-VAULT.local.txt holds the throwaway vault password and MCP tokens,
# opencode.json points a project-local MCP server at the debug binary.
# See TEST-VAULT.local.txt §5 for the cleanup procedure.
opencode.json
opencode.jsonc
*.local.txt

# OS / editors
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
